APP_ENV=development
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/defense_hackathon

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=2
REFRESH_TOKEN_EXPIRY_DAYS=7

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# AWS S3
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=defense-hackathon-2026
AWS_REGION=ap-south-1

# Email (SendGrid)
SENDGRID_API_KEY=xxx
EMAIL_FROM=noreply@defensehackathon2026.com
EMAIL_FROM_NAME=Defense Hackathon 2026

# App URLs
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@defensehackathon2026.com
